# AEGIS - .gitignore

# Environment files
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.egg

# Go
/gateway/aegis-gateway
*.exe

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
.docker/

# Logs
*.log
logs/

# ML models (downloaded at runtime)
models/*.bin
models/*.pt

# Test artifacts
.pytest_cache/
htmlcov/
.coverage

# Build artifacts
dist/
build/